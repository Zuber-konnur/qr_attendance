# ==============================================================
# Smart QR Attendance Platform - Environment Configuration
# ==============================================================

# 1. Multi-Database Connection String (Choose one)
# --------------------------------------------------------------
# Option A: SQLite (Default local zero-config file DB)
DATABASE_URL=sqlite:///attendance.db

# Option B: PostgreSQL / Supabase
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/attendance_db

# Option C: MySQL
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/attendance_db

# 2. Flask Security & Admin Credentials
# --------------------------------------------------------------
SECRET_KEY=super_secure_production_secret_key_change_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 3. Dynamic QR & Geofence Defaults
# --------------------------------------------------------------
SHARED_SECRET=JBSWY3DPEHPK3PXP
TOTP_INTERVAL=30
TIMEZONE=Asia/Kolkata
DEFAULT_GEOFENCE_RADIUS=100.0